# For Local Development (SQLite Ready Out-Of-The-Box):
DATABASE_URL="file:./dev.db"

# For Production PostgreSQL Deployment (use with prisma/schema.postgresql.prisma):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sherzad_erp?schema=public"

JWT_SECRET="replace-with-secure-64-char-random-secret-in-production"
NEXT_PUBLIC_APP_NAME="Sherzad Enterprise ERP"
ENVIRONMENT_MODE="production"
